@using OMC.ResidentEvil.BackEnd.DTOS
@using Radzen.Blazor.Rendering

<div class="newEntry">
    <h3>Videogames</h3> 
    <RadzenDataGrid @ref="grid"
                    AllowFiltering    = "true"
                    AllowPaging       = "true"
                    AllowSorting      = "true"
                    AllowColumnResize = "true"
                    Data= "@games"
                    TItem= "VideogameDTO"
                    PageSize="8">
                    <Columns>
                        <RadzenDataGridColumn Property="VideogameDTO.Id"        Title="Id"     Width="160px"/>
                        <RadzenDataGridColumn Property="VideogameDTO.Name"      Title="Name"   Width="160px"/>
                        <RadzenDataGridColumn Property="VideogameDTO.Year"      Title="Year"   Width="100px"/>
                        <RadzenDataGridColumn Property="VideogameDTO.HasRemake" Title="Remake" Width="100px" />
                        <RadzenDataGridColumn Title="Actions" Width="160px">
                            <Template Context="videogame">
                                <RadzenButton Icon="delete"     Click="@(() => Delete(videogame.Id))"
                                       ButtonStyle="ButtonStyle.Danger" title="Delete"/>
                                <RadzenButton Icon="edit"       Click="@(() => Edit(videogame.Id))"
                                       ButtonStyle="ButtonStyle.Secondary" />
                                <RadzenButton Icon="pageview"   Click="@(() => ViewCharacters(videogame.Id))"
                                       ButtonStyle="ButtonStyle.Info" title="Characters"/>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
    </RadzenDataGrid>
</div>

<div class="newEntry">
    <ul>
        <li class="listLine">
            @if (!isEditActive)
                { <h3> New Game </h3> }
           else { <h3> Update Videogame Data </h3> }
        </li>
        <li class="listLine">
            <RadzenLabel Text ="Name" />
            <RadzenTextBox Placeholder="Name" @bind-Value="game.Name"/>

            <RadzenLabel Text="Year" />   
            <RadzenNumeric Placeholder="Year" @bind-Value="game.Year"/>

            <RadzenLabel Text="Remake" />
            <RadzenCheckBox @bind-Value="game.HasRemake" /> 
           
            @if (!isEditActive)
                 { <RadzenButton Text="Add"    Click="Add"/> }
            else{ <RadzenButton Text="Update" Click="Update"/>}

        </li>
    </ul>
</div>

<div class="newEntry">
    <h2>Characters</h2>

    <RadzenDataGrid @ref="chargrid"
                    AllowFiltering="true"
                    AllowPaging="true"
                    AllowSorting="true"
                    AllowColumnResize="true"
                    Data="@characters"
                    TItem="CharacterDTO"
                    PageSize="8">
        <Columns>
            <RadzenDataGridColumn Property="CharacterDTO.Id" Title="Id" Width="60px" />
            <RadzenDataGridColumn Property="CharacterDTO.FirstName" Title="First Name" Width="160px" />
            <RadzenDataGridColumn Property="CharacterDTO.MiddleName" Title="Middle Name" Width="160px" />
            <RadzenDataGridColumn Property="CharacterDTO.LastName" Title="Last Name" Width="160px" />
            <RadzenDataGridColumn Property="CharacterDTO.IsMain" Title="Main" Width="100px" />
            <RadzenDataGridColumn Property="CharacterDTO.IsVillian" Title="Villian" Width="100px" />
        </Columns>
    </RadzenDataGrid>
</div>