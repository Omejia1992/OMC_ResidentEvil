@using OMC.ResidentEvil.BackEnd.DTOS
@using Radzen.Blazor.Rendering

<div class="newEntry">
    <h3> Characters </h3>

    @if (cOptions != null)
    {
        <select name="Options" @onchange="selectedCharacter">
            @foreach (var item in cOptions)
            {
                <option value="@item.Key"> @item.Value </option>    
            }
        </select>
    }

    <RadzenDataGrid @ref="grid"
                    AllowFiltering    ="true"
                    AllowPaging       ="true"
                    AllowSorting      ="true"
                    AllowColumnResize = "true"
                    Data="@characters"
                    TItem="CharacterDTO"
                    PageSize="8">
                    <Columns>
                        <RadzenDataGridColumn Property="CharacterDTO.Id"         Title="Id"          Width="60px"  />
                        <RadzenDataGridColumn Property="CharacterDTO.GamesName" Title="Games"        Width="200px" />
                        <RadzenDataGridColumn Property="CharacterDTO.FirstName"  Title="First Name"  Width="160px" />
                        <RadzenDataGridColumn Property="CharacterDTO.MiddleName" Title="Middle Name" Width="160px" />
                        <RadzenDataGridColumn Property="CharacterDTO.LastName"   Title="Last Name"   Width="160px" />                       
                        <RadzenDataGridColumn Property="CharacterDTO.IsMain"     Title="Main"        Width="100px" />
                        <RadzenDataGridColumn Property="CharacterDTO.IsVillian"  Title="Villian"     Width="100px" />
                        <RadzenDataGridColumn Title="Actions" Width="160px">
                            <Template Context="character">
                                <RadzenButton Icon="delete" Click="@(() => Delete(character.Id))"
                                    ButtonStyle="ButtonStyle.Danger" title="Delete"/>
                                <RadzenButton Icon="edit"   Click="@(() => Edit(character.Id))"
                                    ButtonStyle="ButtonStyle.Success" title="Edit" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>  
    </RadzenDataGrid>
</div>

<div class="newEntry">

        <div >
            <ul>
                @if (!isEditActive){
                    <li class="listLine">
                        <h2>New Character</h2>
                    </li>
                    <li class="listLine">
                        <RadzenLabel Text="Videogame"/>
                        <RadzenDropDown TValue="int" Data="@games" TextProperty="Name" ValueProperty="Id" 
                        Placeholder="Select Game" @bind-Value="@character.Game.Id"/>

                        <RadzenDropDown TValue="int" Data="@characters" TextProperty="FullName" ValueProperty="Id"
                        Placeholder="Select Character" @bind-Value="character.Id"/>
                    </li>            
                }
                <li class="listLine">
                @if (!isEditActive)
                { <h3> If your Character is not yet available, register it </h3> }
                else
                { <h3> Update your Character Data </h3> }
            </li>
                <li class="listLine">
                    <RadzenLabel   Text = "First Name"/>
                    <RadzenTextBox Placeholder = "First Name"  @bind-Value="character.FirstName"/>

                    <RadzenLabel   Text = "Middle Name"/>
                    <RadzenTextBox Placeholder = "Middle Name" @bind-Value="character.MiddleName"/>

                    <RadzenLabel   Text = "Last Name" />
                    <RadzenTextBox Placeholder = "Last Name"   @bind-Value="character.LastName"/>

                    <RadzenLabel   Text = "Main Character" />
                    <RadzenCheckBox @bind-Value="character.IsMain" />

                    <RadzenLabel Text="Is a Villian" />
                    <RadzenCheckBox @bind-Value="character.IsVillian" />

                    <RadzenLabel Text="Is a Sidekick" />
                    <RadzenCheckBox @bind-Value="character.IsSidekick" />

                    @if (!isEditActive)
                         { <RadzenButton Text="Add" Click="Add"/> }
                    else { <RadzenButton Text="Save Changes" Click="Update" />}
                </li>
            </ul>
        </div>
</div>